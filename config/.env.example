# Intern Absenteeism Monitoring System — environment variable template
#
# Copy this file to config/.env and fill in real values there. Never commit
# .env or any file containing real credentials — see .gitignore.
#
# In production these are expected to live as Airtable Automation secrets /
# input variables (never as plain Airtable fields), per the Requirements
# Engineering Specification (section 3, "Credential storage") — this file
# only documents the variable names for local reference and future tooling.

# Jibble REST API key (schedules, attendance, holidays, leave data)
JIBBLE_API_KEY=

# Airtable API key / personal access token (base read/write access)
AIRTABLE_API_KEY=
